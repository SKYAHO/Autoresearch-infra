project_id       = "your-gcp-project-id"
region           = "asia-northeast3"
zone             = "asia-northeast3-a"
gke_cluster_name = "autoresearch-dev-gke"
resource_prefix  = "autoresearch-dev"

app_k8s_namespace       = "autoresearch"
app_k8s_service_account = "autoresearch-app"

# Optional. Empty value derives:
# autoresearch-dev-app@<project_id>.iam.gserviceaccount.com
app_gcp_service_account_email = ""

# Agent Orchestration API와 Runner GSA는 dev root output
# agent_orchestration_deployment_contract와 대조한다. 빈 값은 아래 기본값을
# 파생한다: autoresearch-dev-orch-api|runner@<project_id>.iam.gserviceaccount.com
agent_orchestration_api_k8s_service_account    = "agent-orchestration-api"
agent_orchestration_runner_k8s_service_account = "agent-orchestration-runner"
agent_orchestration_api_gcp_service_account_email    = ""
agent_orchestration_runner_gcp_service_account_email = ""

# #424 GitHub Environment → WIF provider → GSA → namespace → KSA 튜플은 불변이다.
# 아래 namespace/KSA는 terraform/envs/dev의 feast_apply_kubernetes_identities,
# GSA는 해당 GitHub Environment의 FEAST_APPLY_SA와 반드시 함께 바꾼다.
feast_apply_identities = {
  dev = {
    namespace                 = "feast-apply-dev"
    service_account           = "feast-apply"
    gcp_service_account_email = "autoresearch-dev-feast-dev@your-gcp-project-id.iam.gserviceaccount.com"
  }
  prod = {
    namespace                 = "feast-apply-prod"
    service_account           = "feast-apply"
    gcp_service_account_email = "autoresearch-dev-feast-prod@your-gcp-project-id.iam.gserviceaccount.com"
  }
}

# terraform/envs/dev private_services_cidr, redis_psc_subnet_cidr, gke_services_cidr values.
private_services_cidr = "192.168.0.0/20"
redis_psc_subnet_cidr = "10.10.16.0/29"
cluster_services_cidr = "172.16.128.0/24"

# Memorystore for Redis Cluster fixed discovery/data-node port ranges.
redis_discovery_port  = 6379
redis_node_port_start = 11000
redis_node_port_end   = 13047

# #252 view + pods/portforward, #266 pods/exec 부여 대상.
# 실제 Google 계정은 로컬 terraform.tfvars에만 둔다(예시는 placeholder).
autoresearch_viewer_user_emails = [
  "teammate-1@example.com",
]
