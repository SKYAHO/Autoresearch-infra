project_id = "your-gcp-project-id"

region      = "asia-northeast3"
zone        = "asia-northeast3-a"
environment = "dev"
name_prefix = "autoresearch"

labels = {
  owner = "infra"
}

# dev VPC / subnet (#2)
dev_subnet_cidr              = "10.10.0.0/20"
enable_private_google_access = true

# dev Cloud SQL (#4)
db_database_version     = "POSTGRES_15"
db_tier                 = "db-g1-small"
db_name                 = "autoresearch"
db_app_user             = "app"
sql_deletion_protection = false
private_services_cidr   = "192.168.0.0/20" # 현재 dev apply 값. dev subnet/GKE 대역과 미중복

# Feast Online Store Redis Cluster (#129) — IAM auth/TLS는 코드에서 상시 활성
redis_psc_subnet_cidr              = "10.10.16.0/29" # PSC discovery/internal backend 전용, 다른 VPC/GKE 대역과 미중복
redis_node_type                    = "REDIS_SHARED_CORE_NANO"
redis_shard_count                  = 2
redis_replica_count                = 0
redis_cluster_deletion_protection  = false

# GKE (#5)
gke_master_ipv4_cidr              = "172.16.0.0/28" # private 컨트롤 플레인. dev subnet/private services와 미중복
gke_pods_cidr                     = "172.16.64.0/20"
gke_services_cidr                 = "172.16.128.0/24"
gke_machine_type                  = "e2-standard-4"
gke_node_count_min                = 1
gke_node_count_max                = 2
gke_node_disk_size                = 30
gke_node_disk_type                = "pd-standard"
gke_release_channel               = "REGULAR"
gke_deletion_protection           = false
master_authorized_networks        = [] # IP 엔드포인트 예비 경로용(선택, CIDR 문자열 목록). 기본 kubectl 접속은 --dns-endpoint(#45)
airflow_gke_node_pool_name        = "airflow-dev"
airflow_gke_machine_type          = "e2-standard-2"
airflow_gke_node_count_min        = 1
airflow_gke_node_count_max        = 2
airflow_gke_node_disk_size        = 30
airflow_gke_node_disk_type        = "pd-standard"
gke_app_k8s_namespace             = "autoresearch"
gke_app_k8s_service_account       = "autoresearch-app"
# Paired Feast experiment runtime KSA. 실제 namespace/KSA와 GSA annotation은
# terraform/admin/autoresearch-k8s에서 함께 관리한다.
experiment_runtime_k8s_namespace       = "experiment-runtime"
experiment_runtime_k8s_service_account = "experiment-runtime"
agent_orchestration_db_name        = "agent_orchestration"
agent_orchestration_db_user        = "agent_orchestration_app"
# Cloud SQL built-in user 생성 전에 운영자 migration 절차로 같은 custom role을
# 만들어야 한다. role이 없으면 apply가 실패하며 cloudsqlsuperuser user를 만들지 않는다.
agent_orchestration_runtime_database_role = "agent_orchestration_runtime"
agent_orchestration_k8s_namespace  = "autoresearch"
agent_orchestration_api_k8s_service_account    = "agent-orchestration-api"
agent_orchestration_runner_k8s_service_account = "agent-orchestration-runner"

# #424 Feast apply GKE Job의 환경별 namespace/KSA. 실제 오브젝트와 GSA annotation은
# terraform/admin/autoresearch-k8s가 생성한다. Task 2의 WI subject와 아래 값 및
# admin root의 feast_apply_identities 값은 반드시 함께 유지한다.
feast_apply_kubernetes_identities = {
  dev = {
    namespace       = "feast-apply-dev"
    service_account = "feast-apply"
  }
  prod = {
    namespace       = "feast-apply-prod"
    service_account = "feast-apply"
  }
}

# MLflow (#91 설계, #92 bucket/GSA, #93 Cloud SQL DB/user). K8s namespace/SA는 #94에서 생성.
mlflow_k8s_namespace              = "mlflow"
mlflow_k8s_service_account        = "mlflow"
mlflow_db_name                    = "mlflow"
mlflow_db_user                    = "mlflow"
# 0이면 training snapshot을 age 기반으로 자동 삭제하지 않는다(#464).
mlflow_training_snapshot_retention_days   = 0
# MLflow artifact의 noncurrent generation은 30일 후 정리한다.
mlflow_artifact_noncurrent_retention_days = 30
airflow_k8s_namespace             = "airflow"
airflow_k8s_service_account       = "airflow"
airflow_batch_k8s_service_account = "autoresearch-batch"
airflow_api_k8s_secret_name       = "autoresearch-airflow-env"

raw_data_bucket_location                   = "asia-northeast3"
raw_data_bucket_storage_class              = "STANDARD"
raw_data_noncurrent_version_retention_days = 30

bigquery_location                   = "asia-northeast3"
bigquery_delete_contents_on_destroy = false

feast_bucket_location                            = "asia-northeast3"
feast_bucket_storage_class                       = "STANDARD"
feast_registry_noncurrent_version_retention_days = 30
feast_staging_object_retention_days              = 7

# dev proxy Cloud Run (#27)
proxy_image               = "" # 비우면 dev AR 리포의 proxy:dev-20260708-001 예시 태그. 재배포 시 새 tag/digest로 변경
proxy_ingress             = "INGRESS_TRAFFIC_INTERNAL_ONLY"
proxy_max_instances       = 1
proxy_cpu                 = "1"
proxy_memory              = "512Mi"
proxy_invoker_members     = [] # airflow-batch는 코드에서 부여. 추가 호출 주체만 "serviceAccount:..."로 추가
proxy_deletion_protection = false

# dev Bastion Host (#47) — IAP 터널 전용
bastion_enabled      = true
bastion_machine_type = "e2-micro"
bastion_disk_size_gb = 10
bastion_image        = "debian-cloud/debian-12"

# Airflow UI 내부 노출 (#48)
internal_dns_domain = "dev.autoresearch.internal"
