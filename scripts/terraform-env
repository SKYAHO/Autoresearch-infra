#!/bin/sh
# dev 환경 카탈로그를 검증하고 Terraform root별 입력·backend를 전달한다.
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
environment=""
root=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --environment)
      environment=${2:?--environment 값이 필요합니다}
      shift 2
      ;;
    --root)
      root=${2:?--root 값이 필요합니다}
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

[ "$environment" = "dev" ] || { echo "지원하지 않는 환경입니다: $environment" >&2; exit 2; }
[ -n "$root" ] || { echo "--root 값이 필요합니다" >&2; exit 2; }
[ "$#" -gt 0 ] || { echo "Terraform 명령이 필요합니다" >&2; exit 2; }

command=$1
shift
catalog="$repository_root/config/environments/$environment/environment.yaml"
generated=$(ruby "$repository_root/scripts/environment_catalog.rb" --catalog "$catalog" --root "$root" --output-root "$repository_root")
backend_file=$(printf '%s' "$generated" | ruby -rjson -e 'value = JSON.parse(STDIN.read); print(value["backend_file"] || "")')

if [ "$command" = "init" ]; then
  # `[ ... ] && exec ...` 형태는 조건이 거짓일 때 AND-OR 리스트가 non-zero로
  # 끝난다. set -e 아래에서 그 리스트가 루프 본문의 마지막 명령이면 루프 자체의
  # 종료 상태가 non-zero가 되어, 셸 구현에 따라 errexit로 스크립트가 조용히
  # 죽을 수 있다(bash-as-sh와 dash의 동작이 갈리는 영역). CI는 dash를 쓰므로
  # 셸 의존 동작에 기대지 않고 명시적 if/변수로 분기한다.
  use_backend_config=1
  for argument in "$@"; do
    if [ "$argument" = "-backend=false" ]; then
      use_backend_config=0
      break
    fi
  done
  if [ -z "$backend_file" ]; then
    use_backend_config=0
  fi

  if [ "$use_backend_config" -eq 1 ]; then
    exec terraform -chdir="$root" init -backend-config="$backend_file" "$@"
  fi
  exec terraform -chdir="$root" init "$@"
fi

exec terraform -chdir="$root" "$command" "$@"
